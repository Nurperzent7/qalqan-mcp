[Unit]
Description=Qalqan Platform MCP server (Oxima)
After=network-online.target
Wants=network-online.target

[Service]
User=qalqan
WorkingDirectory=/opt/qalqan-mcp
Environment=PYTHONIOENCODING=utf-8
# Хранилище OAuth-токенов FastMCP; переживает перезапуски и обновления кода.
Environment=FASTMCP_HOME=/var/lib/qalqan-mcp
ExecStart=/opt/qalqan-mcp/.venv/bin/python server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
