# Токен API Оксимы (app.oxima.kz → настройки аккаунта)
OXIMA_TOKEN=''

# Публичный адрес сервера (через Cloudflare Tunnel)
PUBLIC_URL=https://mcp.qalqan.org
# Пускать только Google-аккаунты этого домена
ALLOWED_DOMAIN=qalqan.org

# OAuth-клиент Google (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Длинная случайная строка; не меняйте без нужды — иначе всем придётся войти заново
JWT_SIGNING_KEY=

# Локальный адрес, на который смотрит туннель
HOST=127.0.0.1
PORT=8765

# 1 — без авторизации, только для локальной проверки
AUTH_DISABLED=0
